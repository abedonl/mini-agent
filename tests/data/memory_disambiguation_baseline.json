        "query_mean_ms": [290, 271, 288],
        "query_max_ms": [406, 578, 487],
        "embeddings_jsonl_bytes": 663551,
        "runs_observed": 3,
        "clean_runs": 2
      },
      "frozen": {
        "baseline": {
          "recall@3": 1.0,
          "recall@5": 1.0,
          "disambiguation": 0.925926
        },
        "hybrid": {
          "recall@3": 1.0,
          "recall@5": 1.0,
          "disambiguation": 0.962963
        }
      }
    }
  },
